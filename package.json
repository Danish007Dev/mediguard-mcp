{
  "name": "mediguard-mcp",
  "version": "1.0.0",
  "description": "Medication Safety Intelligence MCP Server for preventing adverse drug events",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server.js",
    "inspect:dev": "npm run build && npm run inspect",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:safety": "jest tests/safety",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "validate:feature1": "node scripts/validateFeature1PubMed.mjs",
    "generate:feature2-sheet": "node scripts/generateFeature2ReviewSheet.mjs",
    "validate:feature3": "npm run test:unit -- whatIfSimulation simulateWhatIfMedicationChange && npx jest tests/safety/whatIfSimulation.performance.safety.test.ts",
    "validate:feature4": "npm run test:unit -- decisionTraceService getDecisionTraceTool getDecisionTraceDashboardTool checkDrugInteractionsTool analyzePolypharmacyTool checkContraindicationsTool getSaferAlternativesTool explainMedicationSafetyTool calculatePatientSafetyScoreTool simulateWhatIfMedicationChangeTool && npx jest tests/safety/decisionTrace.performance.safety.test.ts",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm test",
    "prepare": "husky install",
    "demo:agents": "npx ts-node demos/multi-agent-demo.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('coverage',{recursive:true,force:true});\""
  },
  "keywords": [
    "mcp",
    "healthcare",
    "medication-safety",
    "drug-interactions",
    "fhir",
    "sharp",
    "clinical-decision-support"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.7.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.6.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
