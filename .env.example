# MediGuard MCP - Environment Variables

# =============================================================================
# API KEYS (REQUIRED)
# =============================================================================

# Groq API Key (Primary LLM provider)
# Get from: https://console.groq.com/
GROQ_API_KEY=

# Gemini API Key (Fallback LLM provider)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# =============================================================================
# API ENDPOINTS (OPTIONAL - Have defaults)
# =============================================================================

# RxNorm API (Public, no key needed)
# Default: https://rxnav.nlm.nih.gov/REST
RXNORM_API_URL=https://rxnav.nlm.nih.gov/REST

# OpenFDA API (Public, no key needed)
# Default: https://api.fda.gov
OPENFDA_API_URL=https://api.fda.gov

# Groq API (Primary LLM provider)
# Default: https://api.groq.com/openai/v1
GROQ_API_URL=https://api.groq.com/openai/v1

# Gemini API (Fallback LLM provider)
# Default: https://generativelanguage.googleapis.com/v1beta
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# DailyMed API (Public, no key needed)
# Default: https://dailymed.nlm.nih.gov/dailymed
DAILYMED_API_URL=https://dailymed.nlm.nih.gov/dailymed

# =============================================================================
# FHIR CONFIGURATION (OPTIONAL - For testing)
# =============================================================================

# FHIR Test Server
# Default: https://hapi.fhir.org/baseR4
# For testing only - real endpoints come from SHARP context
FHIR_TEST_ENDPOINT=https://hapi.fhir.org/baseR4

# FHIR Test Token (if needed for test server)
FHIR_TEST_TOKEN=

# Enable live FHIR integration tests (set true to run HAPI integration test suite)
ENABLE_LIVE_FHIR_TESTS=true

# Optional patient id override for live FHIR integration tests
FHIR_TEST_PATIENT_ID=

# FHIR pagination and search limits
FHIR_PAGE_SIZE=50
FHIR_MAX_PAGES=20

# Default OAuth2 token endpoint fallback (optional)
FHIR_DEFAULT_TOKEN_ENDPOINT=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# MCP Server Port (if using HTTP transport)
# Default: stdio (recommended for MCP)
MCP_SERVER_PORT=3000

# MCP Server metadata
MCP_SERVER_NAME=mediguard-mcp
MCP_SERVER_VERSION=0.1.0

# Log Level
# Options: debug, info, warn, error
# Default: info
LOG_LEVEL=info

# Environment
# Options: development, production, test
# Default: development
NODE_ENV=development

# =============================================================================
# PERFORMANCE & CACHING
# =============================================================================

# Cache TTL for drug lookups (in seconds)
# Default: 86400 (24 hours)
DRUG_CACHE_TTL=86400

# Cache TTL for FHIR resources (in seconds)
# Default: 300 (5 minutes)
FHIR_CACHE_TTL=300

# Max cache size (number of items)
# Default: 10000
MAX_CACHE_SIZE=10000

# API Request Timeout (in milliseconds)
# Default: 5000 (5 seconds)
API_TIMEOUT_MS=5000

# Primary and fallback model selection
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-flash

# =============================================================================
# SAFETY & COMPLIANCE
# =============================================================================

# Enable audit logging
# Default: true
ENABLE_AUDIT_LOG=true

# Audit log file path
# Default: ./logs/audit.log
AUDIT_LOG_PATH=./logs/audit.log

# Enable PHI detection warnings (development only)
# Default: true in development, false in production
ENABLE_PHI_DETECTION=true

# =============================================================================
# RATE LIMITING
# =============================================================================

# RxNorm API rate limit (requests per minute)
# Default: 20 (conservative estimate)
RXNORM_RATE_LIMIT=20

# Claude API rate limit (requests per minute)
# Default: 50 (check your tier)
CLAUDE_RATE_LIMIT=50

# OpenFDA API rate limit (requests per minute)
# Default: 240 (from their docs)
OPENFDA_RATE_LIMIT=240

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable LLM synthesis (set to false to use rule-based only)
# Default: true
ENABLE_LLM_SYNTHESIS=true

# Enable FHIR integration
# Default: true
ENABLE_FHIR_INTEGRATION=true

# Enable SHARP context support
# Default: true
ENABLE_SHARP_CONTEXT=true

# Enable prompt caching for Claude API
# Default: true
ENABLE_PROMPT_CACHING=true

# =============================================================================
# TESTING (Test environment only)
# =============================================================================

# Use mock APIs during testing
# Default: false
USE_MOCK_APIS=false

# Mock API delay (milliseconds) for testing timeout handling
# Default: 0
MOCK_API_DELAY=0

# =============================================================================
# MARKETPLACE (For Prompt Opinion deployment)
# =============================================================================

# Prompt Opinion Server ID (assigned after publishing)
PROMPT_OPINION_SERVER_ID=

# Prompt Opinion API Key (for server updates)
PROMPT_OPINION_API_KEY=

# =============================================================================
# MONITORING (Optional)
# =============================================================================

# Enable performance metrics
# Default: false
ENABLE_METRICS=false

# Metrics export endpoint (e.g., for Prometheus)
METRICS_ENDPOINT=

# Sentry DSN (for error tracking)
SENTRY_DSN=

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# Enable debug mode (verbose logging)
DEBUG=false

# Enable hot reload (for development)
HOT_RELOAD=false

# Pretty print JSON logs (development only)
PRETTY_LOGS=true
